{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "breach-online-alpha",
  "main": "apps/server/src/index.js",
  "compatibility_date": "2026-08-14",
  "vars": {
    "GAME_ORIGIN": "*"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true
  }
}
